<script>
function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
}

function fmtBytes(n) {
    if (n === null || n === undefined) { return 'unknown'; }
    var units = ['B', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB'];
    var i = 0;
    while (n >= 1024 && i < units.length - 1) { n /= 1024; i++; }
    return n.toFixed(1) + ' ' + units[i];
}

function fmtTime(ts) {
    return new Date(ts * 1000).toLocaleTimeString();
}

// Every $.post below funnels through here so a request failure (nginx down,
// a 500, a dropped connection) always surfaces the HTTP status and body
// instead of the request just silently going nowhere.
function godwitApiCall(action, params) {
    var post = Object.assign({ csrf_token: csrf_token, action: action }, params || {});
    return $.post('/plugins/godwit/scripts/godwit-api.php', post, null, 'json');
}

function godwitRender(data) {
    var el = document.getElementById('godwit-status');
    if (data.error) {
        el.innerHTML = '<p>' + esc(data.error) + '</p>';
        return;
    }
    var html = '';
    html += '<p>Daemon: <b>' + (data.daemon_running ? 'running' : 'stopped') + '</b></p>';
    html += '<p>Bundled rclone: ' + esc(data.rclone_version || 'unknown') + '</p>';
    html += '<p>rcd listener: ' + esc(data.listener || 'none') + '</p>';
    html += '<p>rc/noop: ' + (data.rc_noop_ok ? 'ok' : 'failed') + '</p>';
    html += '<p>Last heartbeat: ' +
        (data.last_heartbeat_ts ? esc(new Date(data.last_heartbeat_ts * 1000).toLocaleString()) : 'never') + '</p>';
    el.innerHTML = html;
}

function godwitPoll(action) {
    godwitApiCall(action || 'status', {})
        .done(godwitRender)
        .fail(function (xhr) {
            document.getElementById('godwit-status').innerHTML =
                '<p style="color:red">status request failed: ' + esc(xhr.status) + ' ' + esc(xhr.statusText) + '</p>';
        });
}

// Background table refresh: NEVER touches #godwit-remotes-message. That div
// belongs to the most recent user action (Test/Add/Reauth/Delete) and must
// keep showing its result until the user does something else — this refresh
// runs after every action and every 30s regardless.
//
// Skipped while an action is in flight (godwitActionPending): the table row
// buttons live inside the HTML this rebuilds, so a 30s tick landing mid-Test
// (up to 60s) or mid-Reauth (a Graph round trip) would replace the disabled
// "Testing gdrive…" button with a fresh enabled one, letting a second click
// fire the same action twice.
var godwitActionPending = false;

function godwitRemotesRefresh() {
    if (godwitActionPending) { return; }
    godwitApiCall('remotes_list', {})
        .done(function (data) {
            var el = document.getElementById('godwit-remotes-list');
            if (data.error) {
                el.innerHTML = '<p style="color:red">' + esc(data.error) + '</p>';
                return;
            }
            var remotes = data.remotes || [];
            if (remotes.length === 0) {
                el.innerHTML = '<p>No remotes configured yet.</p>';
                return;
            }
            var html = '<table border="1" cellpadding="4"><tr><th>Name</th><th>Type</th><th>Status</th>' +
                '<th>Last checked</th><th>Used / Total</th><th>Actions</th></tr>';
            remotes.forEach(function (r) {
                var checked = r.checked_ts ? new Date(r.checked_ts * 1000).toLocaleString() : 'never';
                var quota = (r.total !== null && r.total !== undefined)
                    ? fmtBytes(r.used) + ' / ' + fmtBytes(r.total) + (r.pct !== null ? ' (' + r.pct.toFixed(1) + '%)' : '')
                    : (r.used !== null ? fmtBytes(r.used) + ' used (unlimited)' : 'unknown');
                html += '<tr>' +
                    '<td>' + esc(r.name) + '</td>' +
                    '<td>' + esc(r.type) + '</td>' +
                    '<td>' + esc(r.status) + '</td>' +
                    '<td>' + esc(checked) + '</td>' +
                    '<td>' + esc(quota) + '</td>' +
                    '<td>' +
                    '<button type="button" class="godwit-test" data-name="' + esc(r.name) + '">Test</button> ' +
                    '<button type="button" class="godwit-reauth" data-name="' + esc(r.name) + '">Re-authorise</button> ' +
                    '<button type="button" class="godwit-delete" data-name="' + esc(r.name) + '">Delete</button>' +
                    '</td></tr>';
            });
            html += '</table>';
            el.innerHTML = html;

            el.querySelectorAll('.godwit-test').forEach(function (btn) {
                btn.addEventListener('click', function () { godwitTest(btn); });
            });
            el.querySelectorAll('.godwit-reauth').forEach(function (btn) {
                btn.addEventListener('click', function () { godwitReauth(btn); });
            });
            el.querySelectorAll('.godwit-delete').forEach(function (btn) {
                btn.addEventListener('click', function () { godwitDelete(btn); });
            });
        })
        .fail(function (xhr) {
            document.getElementById('godwit-remotes-list').innerHTML =
                '<p style="color:red">could not refresh remotes: ' + esc(xhr.status) + ' ' + esc(xhr.statusText) + '</p>';
        });
}

function godwitShowMessage(html) {
    document.getElementById('godwit-remotes-message').innerHTML = html;
}

function godwitShowJobsMessage(html) {
    document.getElementById('godwit-jobs-message').innerHTML = html;
}

function godwitErrorHtml(message) {
    return '<p style="color:red">' + esc(message) + '</p>';
}

// Runs a user-triggered action (Test/Add/Reauth/Delete, or a Jobs-page
// action): disables the triggering control and shows a pending label, then
// shows the result (or error) in the persistent message div, then refreshes
// silently. $control may be a single button or an array of controls (an Add
// form's button plus its inputs) to disable together. $showMessage/$refresh
// default to the Remotes section's own message div and 30s refresh so every
// existing remotes_* call site is unchanged; jobs actions pass their own.
function godwitRunAction(action, params, controls, pendingLabel, onResult, showMessage, refresh) {
    showMessage = showMessage || godwitShowMessage;
    refresh = refresh || godwitRemotesRefresh;
    var list = Array.isArray(controls) ? controls : [controls];
    var button = list.find(function (c) { return c.tagName === 'BUTTON'; }) || list[0];
    var originalLabel = button.textContent;
    list.forEach(function (c) { c.disabled = true; });
    button.textContent = pendingLabel;
    godwitActionPending = true;

    godwitApiCall(action, params)
        .done(function (data) {
            onResult(data);
        })
        .fail(function (xhr) {
            showMessage(godwitErrorHtml('Request failed: ' + xhr.status + ' ' + xhr.statusText));
        })
        .always(function () {
            list.forEach(function (c) { c.disabled = false; });
            button.textContent = originalLabel;
            godwitActionPending = false;
            refresh();
        });
}

function godwitTest(btn) {
    var name = btn.dataset.name;
    godwitRunAction('remotes_test', { name: name }, btn, 'Testing ' + name + '…', function (data) {
        if (data.error) {
            godwitShowMessage(godwitErrorHtml(data.error));
            return;
        }
        var r = data.result;
        if (r.status === 'ok') {
            var quota = (r.total !== null && r.total !== undefined)
                ? fmtBytes(r.total) + ' total, ' + fmtBytes(r.used) + ' used' + (r.pct !== null ? ' (' + r.pct.toFixed(1) + '%)' : '')
                : (r.used !== null ? fmtBytes(r.used) + ' used (unlimited)' : 'no quota info');
            godwitShowMessage('<p style="color:green">' + esc(name) + ': OK — ' + esc(quota) +
                ' — checked ' + esc(fmtTime(r.checked_ts)) + '</p>');
        } else {
            godwitShowMessage('<p style="color:red">' + esc(name) + ': ' + esc(r.status) + ' — ' + esc(r.error) +
                ' — checked ' + esc(fmtTime(r.checked_ts)) + '</p>');
        }
    });
}

function godwitReauth(btn) {
    var name = btn.dataset.name;
    var token = window.prompt('Paste the new token JSON for "' + name + '" (from rclone authorize):');
    if (!token) { return; }
    godwitRunAction('remotes_reauth', { name: name, token: token }, btn, 'Re-authorising ' + name + '…', function (data) {
        if (data.error) {
            godwitShowMessage(godwitErrorHtml(data.error));
            return;
        }
        godwitShowMessage('<p style="color:green">Re-authorised ' + esc(name) + ' — checking connection…</p>');
    });
}

function godwitDelete(btn) {
    var name = btn.dataset.name;
    if (!window.confirm('Delete remote "' + name + '"? This cannot be undone.')) { return; }
    godwitRunAction('remotes_delete', { name: name, confirm: '1' }, btn, 'Deleting ' + name + '…', function (data) {
        if (data.error) {
            godwitShowMessage(godwitErrorHtml(data.error));
            return;
        }
        godwitShowMessage('<p style="color:green">Deleted ' + esc(name) + '.</p>');
    });
}

function godwitHideDrivePicker() {
    document.getElementById('onedrive-picker').style.display = 'none';
}

function godwitShowDrivePicker(type, label, fieldIds, choices, suggested) {
    var picker = document.getElementById('onedrive-picker');
    var choicesEl = document.getElementById('onedrive-picker-choices');
    choicesEl.innerHTML = choices.map(function (c) {
        var checked = c.id === suggested ? ' checked' : '';
        return '<label><input type="radio" name="onedrive-picker-choice" value="' + esc(c.id) + '"' + checked + '> ' +
            esc(c.label) + '</label><br>';
    }).join('');
    picker.dataset.type = type;
    picker.dataset.label = label;
    picker.dataset.fieldIds = JSON.stringify(fieldIds);
    picker.style.display = '';
    godwitShowMessage(godwitErrorHtml('Multiple OneDrive drives found — pick one below and click "Use this drive".'));
}

// $driveId, when set, is a choice made via the drive picker below and is
// sent as an extra field alongside the same form values (which are kept on
// any failure, including "multiple drives found", so a resubmit doesn't
// need the user to re-paste the token).
function godwitAdd(type, label, fieldIds, driveId) {
    var fields = {};
    Object.keys(fieldIds).forEach(function (key) { fields[key] = document.getElementById(fieldIds[key]); });
    var params = {
        name: fields.name.value,
        client_id: fields.client_id.value,
        client_secret: fields.client_secret.value,
        token: fields.token.value,
    };
    var controls = Object.values(fields);
    if (driveId) {
        params.drive_id = driveId;
        // The button the user actually clicked ("Use this drive") — put it
        // first so godwitRunAction picks it, not the original (still
        // visible) Add button also present in `controls` via fields.add.
        controls.unshift(document.getElementById('onedrive-picker-use'));
    } else {
        // A fresh Add attempt: any drive choices offered by a previous
        // attempt no longer apply.
        godwitHideDrivePicker();
    }
    var name = params.name || '(unnamed)';
    godwitRunAction('remotes_add_' + type, params, controls, 'Adding ' + name + '…', function (data) {
        if (data.choose_drive) {
            godwitShowDrivePicker(type, label, fieldIds, data.choose_drive, data.suggested);
            return;
        }
        if (data.error) {
            // Keep the fields on failure so the user can correct them.
            godwitShowMessage(godwitErrorHtml(data.error));
            return;
        }
        fields.client_secret.value = '';
        fields.token.value = '';
        godwitHideDrivePicker();
        var driveNote = data.drive ? ' — drive: ' + esc(data.drive) : '';
        godwitShowMessage('<p style="color:green">Added ' + esc(data.name) + ' (' + esc(label) + ')' + driveNote + ' — checking connection…</p>');
    });
}

function fmtDuration(s) {
    if (s === null || s === undefined) { return 'unknown'; }
    var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);
    return h + 'h ' + m + 'm';
}

var godwitProfileUpstream = { '1000/400': 400, '500/50': 50 };
// Windows/profile fields are only populated from the server on first load —
// never on a later background refresh, or an in-progress edit would be
// silently overwritten out from under the user (same reasoning as the
// action-pending guard on godwitRemotesRefresh()).
var godwitJobsLoaded = false;

function godwitUpdateProfileWarning() {
    var upstream = godwitProfileUpstream[document.getElementById('godwit-profile').value];
    var el = document.getElementById('godwit-profile-warning');
    if (!upstream) { el.innerHTML = ''; return; }
    var windows;
    try { windows = JSON.parse(document.getElementById('godwit-windows').value); } catch (e) { el.innerHTML = ''; return; }
    var worst = Math.max.apply(null, [0].concat((windows || []).map(function (w) { return w.limit_mbit || 0; })));
    el.innerHTML = worst >= 0.8 * upstream
        ? '<p style="color:orange">Window limit ' + worst + ' Mbit/s is at or above 80% of this profile’s ' + upstream + ' Mbit/s upstream — uploads may saturate the line.</p>'
        : '';
}

function godwitJobsRefresh() {
    if (godwitActionPending) { return; }
    godwitApiCall('jobs_status', {})
        .done(function (data) {
            if (data.error) {
                document.getElementById('godwit-jobs-table').innerHTML = godwitErrorHtml(data.error);
                return;
            }
            var budgetHtml = (data.remotes || []).map(function (r) {
                var pct = r.cap_bytes > 0 ? Math.min(100, r.used_24h_bytes / r.cap_bytes * 100) : 0;
                var throttled = r.throttled_until ? ' — throttled until ' + new Date(r.throttled_until * 1000).toLocaleString() : '';
                return '<p>' + esc(r.remote) + ': ' + fmtBytes(r.used_24h_bytes) + ' / ' + fmtBytes(r.cap_bytes) +
                    ' (' + pct.toFixed(1) + '%)' + esc(throttled) +
                    '<br><div style="background:#ddd;width:300px;height:10px;"><div style="background:' +
                    (pct >= 100 ? '#c00' : '#2a6') + ';width:' + pct.toFixed(1) + '%;height:10px;"></div></div></p>';
            }).join('');
            document.getElementById('godwit-budget-bars').innerHTML = budgetHtml || '<p>No remotes configured.</p>';

            var rows = (data.jobs || []).map(function (j) {
                var state = j.running
                    ? 'running — ' + fmtBytes(j.progress.bytes) + ', ' + j.progress.files + ' files, ETA ' + fmtDuration(j.progress.eta_seconds)
                    : (j.last_run
                        ? j.last_run.outcome + ' (' + fmtBytes(j.last_run.bytes) + ') at ' + new Date((j.last_run.ended_ts || j.last_run.started_ts) * 1000).toLocaleString()
                        : 'never run');
                var queue = j.running ? '-' : (j.queue_position !== null ? j.queue_position : '-');
                return '<tr data-name="' + esc(j.name) + '" data-share="' + esc(j.share) + '" data-remote="' + esc(j.remote) + '" data-maxdelete="' + j.max_delete + '">' +
                    '<td>' + esc(j.name) + '</td>' +
                    '<td>' + esc(j.remote) + '</td>' +
                    '<td><input type="checkbox" class="godwit-job-enabled"' + (j.enabled ? ' checked' : '') + '></td>' +
                    '<td><select class="godwit-job-mode">' +
                    '<option value="sync"' + (j.mode === 'sync' ? ' selected' : '') + '>sync</option>' +
                    '<option value="copy"' + (j.mode === 'copy' ? ' selected' : '') + '>copy</option></select></td>' +
                    '<td><input type="number" class="godwit-job-transfers" value="' + j.transfers + '" size="3"></td>' +
                    '<td><input type="text" class="godwit-job-excludes" value="' + esc((j.excludes || []).join(', ')) + '" size="30"></td>' +
                    '<td>' + esc(state) + '</td>' +
                    '<td>' + esc(String(queue)) + '</td>' +
                    '</tr>';
            }).join('');
            document.getElementById('godwit-jobs-table').innerHTML =
                '<table border="1" cellpadding="4"><tr><th>Name</th><th>Remote</th><th>Enabled</th><th>Mode</th>' +
                '<th>Transfers</th><th>Excludes</th><th>Status</th><th>Queue</th></tr>' + rows + '</table>';

            if (!godwitJobsLoaded) {
                document.getElementById('godwit-windows').value = JSON.stringify(data.settings.windows);
                document.getElementById('godwit-profile').value = data.settings.profile;
                godwitJobsLoaded = true;
            }
            godwitUpdateProfileWarning();
            document.getElementById('godwit-pause').disabled = data.paused;
            document.getElementById('godwit-resume').disabled = !data.paused;
            document.getElementById('godwit-run-now').disabled = data.run_now;
        })
        .fail(function (xhr) {
            document.getElementById('godwit-jobs-table').innerHTML =
                '<p style="color:red">could not refresh jobs: ' + esc(xhr.status) + ' ' + esc(xhr.statusText) + '</p>';
        });
}

function godwitJobsSave() {
    var rows = document.querySelectorAll('#godwit-jobs-table tr[data-name]');
    var jobs = Array.prototype.map.call(rows, function (tr) {
        return {
            name: tr.dataset.name,
            share: tr.dataset.share,
            remote: tr.dataset.remote,
            enabled: tr.querySelector('.godwit-job-enabled').checked,
            mode: tr.querySelector('.godwit-job-mode').value,
            transfers: parseInt(tr.querySelector('.godwit-job-transfers').value, 10) || 4,
            max_delete: parseInt(tr.dataset.maxdelete, 10) || 1000,
            excludes: tr.querySelector('.godwit-job-excludes').value.split(',').map(function (s) { return s.trim(); }).filter(Boolean),
        };
    });
    var btn = document.getElementById('godwit-jobs-save');
    godwitRunAction('jobs_save', { jobs: JSON.stringify(jobs) }, btn, 'Saving…', function (data) {
        if (data.error) { godwitShowJobsMessage(godwitErrorHtml(data.error)); return; }
        godwitShowJobsMessage('<p style="color:green">Jobs saved.</p>');
    }, godwitShowJobsMessage, godwitJobsRefresh);
}

function godwitSettingsSave() {
    var windows;
    try {
        windows = JSON.parse(document.getElementById('godwit-windows').value);
    } catch (e) {
        godwitShowJobsMessage(godwitErrorHtml('Windows must be valid JSON: ' + e.message));
        return;
    }
    var settings = { windows: windows, profile: document.getElementById('godwit-profile').value };
    var btn = document.getElementById('godwit-settings-save');
    godwitRunAction('settings_save', { settings: JSON.stringify(settings) }, btn, 'Saving…', function (data) {
        if (data.error) { godwitShowJobsMessage(godwitErrorHtml(data.error)); return; }
        godwitShowJobsMessage('<p style="color:green">Windows/speed saved.</p>');
    }, godwitShowJobsMessage, godwitJobsRefresh);
}

document.getElementById('godwit-jobs-save').addEventListener('click', godwitJobsSave);
document.getElementById('godwit-settings-save').addEventListener('click', godwitSettingsSave);
document.getElementById('godwit-profile').addEventListener('change', godwitUpdateProfileWarning);
document.getElementById('godwit-windows').addEventListener('input', godwitUpdateProfileWarning);
document.getElementById('godwit-run-now').addEventListener('click', function () {
    godwitRunAction('run_now', {}, document.getElementById('godwit-run-now'), 'Starting…', function (data) {
        if (data.error) { godwitShowJobsMessage(godwitErrorHtml(data.error)); return; }
        godwitShowJobsMessage('<p style="color:green">Run now started — the queue will run regardless of the window until it drains or the budget is hit.</p>');
    }, godwitShowJobsMessage, godwitJobsRefresh);
});
document.getElementById('godwit-pause').addEventListener('click', function () {
    godwitRunAction('pause', {}, document.getElementById('godwit-pause'), 'Pausing…', function (data) {
        if (data.error) { godwitShowJobsMessage(godwitErrorHtml(data.error)); return; }
        godwitShowJobsMessage('<p>Paused — no new jobs will start.</p>');
    }, godwitShowJobsMessage, godwitJobsRefresh);
});
document.getElementById('godwit-resume').addEventListener('click', function () {
    godwitRunAction('resume', {}, document.getElementById('godwit-resume'), 'Resuming…', function (data) {
        if (data.error) { godwitShowJobsMessage(godwitErrorHtml(data.error)); return; }
        godwitShowJobsMessage('<p style="color:green">Resumed.</p>');
    }, godwitShowJobsMessage, godwitJobsRefresh);
});

document.getElementById('godwit-start').addEventListener('click', function () { godwitPoll('start'); });
document.getElementById('godwit-stop').addEventListener('click', function () { godwitPoll('stop'); });

document.getElementById('drive-add').addEventListener('click', function () {
    godwitAdd('drive', 'Google Drive', {
        name: 'drive-name', client_id: 'drive-client-id', client_secret: 'drive-client-secret',
        token: 'drive-token', add: 'drive-add',
    });
});

document.getElementById('onedrive-add').addEventListener('click', function () {
    godwitAdd('onedrive', 'OneDrive (personal)', {
        name: 'onedrive-name', client_id: 'onedrive-client-id', client_secret: 'onedrive-client-secret',
        token: 'onedrive-token', add: 'onedrive-add',
    });
});

document.getElementById('onedrive-picker-use').addEventListener('click', function () {
    var picker = document.getElementById('onedrive-picker');
    var checked = document.querySelector('input[name="onedrive-picker-choice"]:checked');
    if (!checked) { window.alert('Choose a drive first.'); return; }
    godwitAdd(picker.dataset.type, picker.dataset.label, JSON.parse(picker.dataset.fieldIds), checked.value);
});

godwitPoll();
setInterval(godwitPoll, 15000);
godwitRemotesRefresh();
setInterval(godwitRemotesRefresh, 30000);
godwitJobsRefresh();
setInterval(godwitJobsRefresh, 15000);
</script>
