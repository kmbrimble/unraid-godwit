<script>
function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
}

function fmtBytes(n) {
    if (n === null || n === undefined) { return 'unknown'; }
    var units = ['B', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB'];
    var i = 0;
    while (n >= 1024 && i < units.length - 1) { n /= 1024; i++; }
    return n.toFixed(1) + ' ' + units[i];
}

function fmtTime(ts) {
    return new Date(ts * 1000).toLocaleTimeString();
}

// Every $.post below funnels through here so a request failure (nginx down,
// a 500, a dropped connection) always surfaces the HTTP status and body
// instead of the request just silently going nowhere.
function godwitApiCall(action, params) {
    var post = Object.assign({ csrf_token: csrf_token, action: action }, params || {});
    return $.post('/plugins/godwit/scripts/godwit-api.php', post, null, 'json');
}

function godwitRender(data) {
    var el = document.getElementById('godwit-status');
    if (data.error) {
        el.innerHTML = '<p>' + esc(data.error) + '</p>';
        return;
    }
    var html = '';
    html += '<p>Daemon: <b>' + (data.daemon_running ? 'running' : 'stopped') + '</b></p>';
    html += '<p>Bundled rclone: ' + esc(data.rclone_version || 'unknown') + '</p>';
    html += '<p>rcd listener: ' + esc(data.listener || 'none') + '</p>';
    html += '<p>rc/noop: ' + (data.rc_noop_ok ? 'ok' : 'failed') + '</p>';
    html += '<p>Last heartbeat: ' +
        (data.last_heartbeat_ts ? esc(new Date(data.last_heartbeat_ts * 1000).toLocaleString()) : 'never') + '</p>';
    el.innerHTML = html;
}

function godwitPoll(action) {
    godwitApiCall(action || 'status', {})
        .done(godwitRender)
        .fail(function (xhr) {
            document.getElementById('godwit-status').innerHTML =
                '<p style="color:red">status request failed: ' + esc(xhr.status) + ' ' + esc(xhr.statusText) + '</p>';
        });
}

// Background table refresh: NEVER touches #godwit-remotes-message. That div
// belongs to the most recent user action (Test/Add/Reauth/Delete) and must
// keep showing its result until the user does something else — this refresh
// runs after every action and every 30s regardless.
//
// Skipped while an action is in flight (godwitActionPending): the table row
// buttons live inside the HTML this rebuilds, so a 30s tick landing mid-Test
// (up to 60s) or mid-Reauth (a Graph round trip) would replace the disabled
// "Testing gdrive…" button with a fresh enabled one, letting a second click
// fire the same action twice.
var godwitActionPending = false;

function godwitRemotesRefresh() {
    if (godwitActionPending) { return; }
    godwitApiCall('remotes_list', {})
        .done(function (data) {
            var el = document.getElementById('godwit-remotes-list');
            if (data.error) {
                el.innerHTML = '<p style="color:red">' + esc(data.error) + '</p>';
                return;
            }
            var remotes = data.remotes || [];
            godwitRemotesCache = remotes;
            var remoteSelect = document.getElementById('job-add-remote');
            var prevRemote = remoteSelect.value;
            remoteSelect.innerHTML = remotes.map(function (r) {
                return '<option value="' + esc(r.name) + '">' + esc(r.name) + ' (' + esc(r.type) + ')</option>';
            }).join('');
            if (remotes.some(function (r) { return r.name === prevRemote; })) { remoteSelect.value = prevRemote; }
            if (remotes.length === 0) {
                el.innerHTML = '<p>No remotes configured yet.</p>';
                return;
            }
            var html = '<table border="1" cellpadding="4"><tr><th>Name</th><th>Type</th><th>Status</th>' +
                '<th>Last checked</th><th>Used / Total</th><th>Actions</th></tr>';
            remotes.forEach(function (r) {
                var checked = r.checked_ts ? new Date(r.checked_ts * 1000).toLocaleString() : 'never';
                var quota = (r.total !== null && r.total !== undefined)
                    ? fmtBytes(r.used) + ' / ' + fmtBytes(r.total) + (r.pct !== null ? ' (' + r.pct.toFixed(1) + '%)' : '')
                    : (r.used !== null ? fmtBytes(r.used) + ' used (unlimited)' : 'unknown');
                html += '<tr>' +
                    '<td>' + esc(r.name) + '</td>' +
                    '<td>' + esc(r.type) + '</td>' +
                    '<td>' + esc(r.status) + '</td>' +
                    '<td>' + esc(checked) + '</td>' +
                    '<td>' + esc(quota) + '</td>' +
                    '<td>' +
                    '<button type="button" class="godwit-test" data-name="' + esc(r.name) + '">Test</button> ' +
                    '<button type="button" class="godwit-reauth" data-name="' + esc(r.name) + '">Re-authorise</button> ' +
                    '<button type="button" class="godwit-delete" data-name="' + esc(r.name) + '">Delete</button>' +
                    '</td></tr>';
            });
            html += '</table>';
            el.innerHTML = html;

            el.querySelectorAll('.godwit-test').forEach(function (btn) {
                btn.addEventListener('click', function () { godwitTest(btn); });
            });
            el.querySelectorAll('.godwit-reauth').forEach(function (btn) {
                btn.addEventListener('click', function () { godwitReauth(btn); });
            });
            el.querySelectorAll('.godwit-delete').forEach(function (btn) {
                btn.addEventListener('click', function () { godwitDelete(btn); });
            });
        })
        .fail(function (xhr) {
            document.getElementById('godwit-remotes-list').innerHTML =
                '<p style="color:red">could not refresh remotes: ' + esc(xhr.status) + ' ' + esc(xhr.statusText) + '</p>';
        });
}

function godwitShowMessage(html) {
    document.getElementById('godwit-remotes-message').innerHTML = html;
}

function godwitShowJobsMessage(html) {
    document.getElementById('godwit-jobs-message').innerHTML = html;
}

function godwitShowDriveAddMessage(html) {
    document.getElementById('drive-add-message').innerHTML = html;
}

function godwitShowOnedriveAddMessage(html) {
    document.getElementById('onedrive-add-message').innerHTML = html;
}

// Which modal dialog and message div a remotes_add_<type> flow belongs to —
// looked up by `type` so the OneDrive drive-picker's own "Use this drive"
// submission (which reaches godwitAdd() the same way a fresh Add click
// does) reports into the same dialog it was opened from.
var godwitAddModalConfig = {
    drive: { dialogId: 'drive-add-dialog', showMessage: godwitShowDriveAddMessage },
    onedrive: { dialogId: 'onedrive-add-dialog', showMessage: godwitShowOnedriveAddMessage },
};

function godwitErrorHtml(message) {
    return '<p style="color:red">' + esc(message) + '</p>';
}

// Runs a user-triggered action (Test/Add/Reauth/Delete, or a Jobs-page
// action): disables the triggering control and shows a pending label, then
// shows the result (or error) in the persistent message div, then refreshes
// silently. $control may be a single button or an array of controls (an Add
// form's button plus its inputs) to disable together. $showMessage/$refresh
// default to the Remotes section's own message div and 30s refresh so every
// existing remotes_* call site is unchanged; jobs actions pass their own.
function godwitRunAction(action, params, controls, pendingLabel, onResult, showMessage, refresh) {
    showMessage = showMessage || godwitShowMessage;
    refresh = refresh || godwitRemotesRefresh;
    var list = Array.isArray(controls) ? controls : [controls];
    var button = list.find(function (c) { return c.tagName === 'BUTTON'; }) || list[0];
    var originalLabel = button.textContent;
    list.forEach(function (c) { c.disabled = true; });
    button.textContent = pendingLabel;
    godwitActionPending = true;

    godwitApiCall(action, params)
        .done(function (data) {
            onResult(data);
        })
        .fail(function (xhr) {
            showMessage(godwitErrorHtml('Request failed: ' + xhr.status + ' ' + xhr.statusText));
        })
        .always(function () {
            list.forEach(function (c) { c.disabled = false; });
            button.textContent = originalLabel;
            godwitActionPending = false;
            refresh();
        });
}

function godwitTest(btn) {
    var name = btn.dataset.name;
    godwitRunAction('remotes_test', { name: name }, btn, 'Testing ' + name + '…', function (data) {
        if (data.error) {
            godwitShowMessage(godwitErrorHtml(data.error));
            return;
        }
        var r = data.result;
        if (r.status === 'ok') {
            var quota = (r.total !== null && r.total !== undefined)
                ? fmtBytes(r.total) + ' total, ' + fmtBytes(r.used) + ' used' + (r.pct !== null ? ' (' + r.pct.toFixed(1) + '%)' : '')
                : (r.used !== null ? fmtBytes(r.used) + ' used (unlimited)' : 'no quota info');
            godwitShowMessage('<p style="color:green">' + esc(name) + ': OK — ' + esc(quota) +
                ' — checked ' + esc(fmtTime(r.checked_ts)) + '</p>');
        } else {
            godwitShowMessage('<p style="color:red">' + esc(name) + ': ' + esc(r.status) + ' — ' + esc(r.error) +
                ' — checked ' + esc(fmtTime(r.checked_ts)) + '</p>');
        }
    });
}

function godwitReauth(btn) {
    var name = btn.dataset.name;
    var token = window.prompt('Paste the new token JSON for "' + name + '" (from rclone authorize):');
    if (!token) { return; }
    godwitRunAction('remotes_reauth', { name: name, token: token }, btn, 'Re-authorising ' + name + '…', function (data) {
        if (data.error) {
            godwitShowMessage(godwitErrorHtml(data.error));
            return;
        }
        godwitShowMessage('<p style="color:green">Re-authorised ' + esc(name) + ' — checking connection…</p>');
    });
}

function godwitDelete(btn) {
    var name = btn.dataset.name;
    if (!window.confirm('Delete remote "' + name + '"? This cannot be undone.')) { return; }
    godwitRunAction('remotes_delete', { name: name, confirm: '1' }, btn, 'Deleting ' + name + '…', function (data) {
        if (data.error) {
            godwitShowMessage(godwitErrorHtml(data.error));
            return;
        }
        godwitShowMessage('<p style="color:green">Deleted ' + esc(name) + '.</p>');
    });
}

function godwitHideDrivePicker() {
    $('#onedrive-picker').dialog('close');
}

function godwitShowDrivePicker(type, label, fieldIds, choices, suggested) {
    var picker = document.getElementById('onedrive-picker');
    var choicesEl = document.getElementById('onedrive-picker-choices');
    choicesEl.innerHTML = choices.map(function (c) {
        var checked = c.id === suggested ? ' checked' : '';
        return '<label><input type="radio" name="onedrive-picker-choice" value="' + esc(c.id) + '"' + checked + '> ' +
            esc(c.label) + '</label><br>';
    }).join('');
    picker.dataset.type = type;
    picker.dataset.label = label;
    picker.dataset.fieldIds = JSON.stringify(fieldIds);
    $(picker).dialog('open');
}

// $driveId, when set, is a choice made via the drive picker below and is
// sent as an extra field alongside the same form values (which are kept on
// any failure, including "multiple drives found", so a resubmit doesn't
// need the user to re-paste the token).
function godwitAdd(type, label, fieldIds, driveId) {
    var cfg = godwitAddModalConfig[type];
    var fields = {};
    Object.keys(fieldIds).forEach(function (key) { fields[key] = document.getElementById(fieldIds[key]); });
    var params = {
        name: fields.name.value,
        client_id: fields.client_id.value,
        client_secret: fields.client_secret.value,
        token: fields.token.value,
    };
    var controls = Object.values(fields);
    if (driveId) {
        params.drive_id = driveId;
        // The button the user actually clicked ("Use this drive") — put it
        // first so godwitRunAction picks it, not the original (still
        // visible) Add button also present in `controls` via fields.add.
        controls.unshift(document.getElementById('onedrive-picker-use'));
    } else {
        // A fresh Add attempt: any drive choices offered by a previous
        // attempt no longer apply.
        godwitHideDrivePicker();
    }
    var name = params.name || '(unnamed)';
    godwitRunAction('remotes_add_' + type, params, controls, 'Adding ' + name + '…', function (data) {
        if (data.choose_drive) {
            godwitShowDrivePicker(type, label, fieldIds, data.choose_drive, data.suggested);
            return;
        }
        if (data.error) {
            // Keep the fields and the dialog open on failure so the user can
            // correct them.
            cfg.showMessage(godwitErrorHtml(data.error));
            return;
        }
        fields.client_secret.value = '';
        fields.token.value = '';
        godwitHideDrivePicker();
        var driveNote = data.drive ? ' — drive: ' + esc(data.drive) : '';
        // Deliberately does not auto-close the dialog: closing it would hide
        // this confirmation the instant it's shown, the same
        // swallowed-result regression 0.2.2 fixed for the page-wide message
        // div. The user closes it once they've read the confirmation.
        cfg.showMessage('<p style="color:green">Added ' + esc(data.name) + ' (' + esc(label) + ')' + driveNote + ' — checking connection…</p>');
    }, cfg.showMessage, godwitRemotesRefresh);
}

function fmtDuration(s) {
    if (s === null || s === undefined) { return 'unknown'; }
    var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);
    return h + 'h ' + m + 'm';
}

// GODWIT_WINDOWS_FORM_BEGIN
// Dependency-free windows-form helpers, exercised directly (with no DOM) by
// tests/windows_form_test.mjs, which extracts exactly this block. Keep it
// free of document/window access.
var godwitDayLabels = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

function godwitHalfHourGrid() {
    var opts = [];
    for (var h = 0; h < 24; h++) {
        opts.push((h < 10 ? '0' : '') + h + ':00');
        opts.push((h < 10 ? '0' : '') + h + ':30');
    }
    return opts;
}

// A window (server schema) and a form row are the same shape; this only
// exists to guarantee the JSON key order (days, start, end, limit_mbit) on
// every save, since that's what keeps an unedited round trip
// byte-identical to what was loaded.
function godwitWindowToRow(w) {
    return { days: (w.days || []).slice(), start: w.start, end: w.end, limit_mbit: w.limit_mbit };
}

function godwitRowToWindow(row) {
    return {
        days: row.days.slice().sort(function (a, b) { return a - b; }),
        start: row.start,
        end: row.end,
        limit_mbit: typeof row.limit_mbit === 'number' ? row.limit_mbit : parseFloat(row.limit_mbit),
    };
}

function godwitWindowsToRows(windows) { return (windows || []).map(godwitWindowToRow); }
function godwitRowsToWindows(rows) { return rows.map(godwitRowToWindow); }

// null = valid. Mirrors the settings_save server-side checks so bad input
// never leaves the browser.
function godwitValidateRow(row) {
    if (!row.days || row.days.length === 0) { return 'each window needs at least one day ticked'; }
    if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(row.start) || !/^([01]\d|2[0-3]):[0-5]\d$/.test(row.end)) {
        return 'start and end must be HH:MM';
    }
    var limit = typeof row.limit_mbit === 'number' ? row.limit_mbit : parseFloat(row.limit_mbit);
    if (!isFinite(limit) || limit <= 0) { return 'speed limit must be a positive number'; }
    return null;
}
// GODWIT_WINDOWS_FORM_END

var godwitProfileUpstream = { '1000/400': 400, '500/50': 50 };
// Windows/profile fields are only populated from the server on first load —
// never on a later background refresh, or an in-progress edit would be
// silently overwritten out from under the user (same reasoning as the
// action-pending guard on godwitRemotesRefresh()).
var godwitJobsLoaded = false;
var godwitWindowRows = [];

function godwitUpdateProfileWarning() {
    var upstream = godwitProfileUpstream[document.getElementById('godwit-profile').value];
    var el = document.getElementById('godwit-profile-warning');
    if (!upstream) { el.innerHTML = ''; return; }
    var worst = Math.max.apply(null, [0].concat(godwitWindowRows.map(function (r) { return parseFloat(r.limit_mbit) || 0; })));
    el.innerHTML = worst >= 0.8 * upstream
        ? '<p style="color:orange">Window limit ' + worst + ' Mbit/s is at or above 80% of this profile’s ' + upstream + ' Mbit/s upstream — uploads may saturate the line.</p>'
        : '';
}

function godwitSyncAdvancedJsonFromForm() {
    document.getElementById('godwit-windows-json').value = JSON.stringify(godwitRowsToWindows(godwitWindowRows), null, 2);
}

function godwitSyncRowFromForm(rowIndex) {
    var i = parseInt(rowIndex, 10);
    var container = document.getElementById('godwit-windows-rows');
    var row = godwitWindowRows[i];
    row.days = Array.prototype.slice.call(container.querySelectorAll('.godwit-window-day[data-row="' + i + '"]:checked'))
        .map(function (cb) { return parseInt(cb.dataset.day, 10); });
    row.start = container.querySelector('.godwit-window-start[data-row="' + i + '"]').value;
    row.end = container.querySelector('.godwit-window-end[data-row="' + i + '"]').value;
    row.limit_mbit = container.querySelector('.godwit-window-limit[data-row="' + i + '"]').value;
    godwitSyncAdvancedJsonFromForm();
    godwitUpdateProfileWarning();
}

function godwitRenderWindowsForm() {
    var container = document.getElementById('godwit-windows-rows');
    var grid = godwitHalfHourGrid();
    function optionsFor(value) {
        var values = grid.slice();
        // A time not on the half-hourly grid (e.g. hand-edited via the raw
        // JSON) is never silently snapped to the nearest slot — it's kept
        // selectable as an extra option instead.
        if (values.indexOf(value) === -1) { values.unshift(value); }
        return values.map(function (v) {
            return '<option value="' + esc(v) + '"' + (v === value ? ' selected' : '') + '>' + esc(v) + '</option>';
        }).join('');
    }
    container.innerHTML = godwitWindowRows.map(function (row, i) {
        var days = godwitDayLabels.map(function (label, d) {
            var checked = row.days.indexOf(d) !== -1 ? ' checked' : '';
            return '<label><input type="checkbox" class="godwit-window-day" data-row="' + i + '" data-day="' + d + '"' + checked + '> ' + label + '</label>';
        }).join(' ');
        var allDayNote = row.start === row.end ? ' <em>(start == end means "all day")</em>' : '';
        return '<div class="godwit-window-row" data-row="' + i + '" style="border:1px solid #ccc;padding:6px;margin-bottom:6px">' +
            '<div>' + days + '</div>' +
            '<label>Start <select class="godwit-window-start" data-row="' + i + '">' + optionsFor(row.start) + '</select></label> ' +
            '<label>End <select class="godwit-window-end" data-row="' + i + '">' + optionsFor(row.end) + '</select></label>' + allDayNote + ' ' +
            '<label>Limit (Mbit/s) <input type="text" inputmode="decimal" class="godwit-window-limit" data-row="' + i + '" value="' + esc(row.limit_mbit) + '" size="5"></label> ' +
            '<button type="button" class="godwit-window-remove" data-row="' + i + '">Remove window</button>' +
            '<div class="godwit-window-row-error" style="color:red"></div>' +
            '</div>';
    }).join('') || '<p>No windows configured — uploads never run automatically outside a "Run now". Add one below.</p>';

    container.querySelectorAll('.godwit-window-day').forEach(function (cb) {
        cb.addEventListener('change', function () { godwitSyncRowFromForm(cb.dataset.row); });
    });
    container.querySelectorAll('.godwit-window-start, .godwit-window-end, .godwit-window-limit').forEach(function (el) {
        el.addEventListener('input', function () { godwitSyncRowFromForm(el.dataset.row); });
        el.addEventListener('change', function () { godwitSyncRowFromForm(el.dataset.row); });
    });
    container.querySelectorAll('.godwit-window-remove').forEach(function (btn) {
        btn.addEventListener('click', function () {
            godwitWindowRows.splice(parseInt(btn.dataset.row, 10), 1);
            godwitRenderWindowsForm();
            godwitSyncAdvancedJsonFromForm();
        });
    });
}

// GODWIT_TREE_BEGIN
// Tri-state tree-selection logic (PLAN.md §4.4: "a folder's
// checkbox includes everything below it; children can be un-ticked to
// exclude"). Pure, DOM-free and dependency-free so tests/windows_form_test.mjs
// can exercise it directly with no browser. `included`/`excluded` are arrays
// of {path, is_dir}, `path` always share-relative with no leading/trailing
// slash. This is deliberately a single level of override — un-ticking a
// child of an included folder excludes it, but nothing lets you re-include
// something nested under an excluded child; PLAN.md doesn't ask for that,
// and the two-list model here can't express it.
function godwitTreeAncestorPaths(path) {
    var parts = path.split('/');
    var out = [];
    for (var i = 1; i <= parts.length; i++) { out.push(parts.slice(0, i).join('/')); }
    return out; // ancestors first, path itself last
}

function godwitTreeFindByPath(list, path) {
    for (var i = 0; i < list.length; i++) { if (list[i].path === path) { return list[i]; } }
    return null;
}

// The *included* entry (closest ancestor, or the node itself) governing
// this path's default state — null if none exists.
function godwitTreeGoverningInclude(path, included) {
    var ancestors = godwitTreeAncestorPaths(path);
    for (var i = ancestors.length - 1; i >= 0; i--) {
        var hit = godwitTreeFindByPath(included, ancestors[i]);
        if (hit) { return hit; }
    }
    return null;
}

// Checked = explicitly included, or an included ancestor governs it and
// neither it nor any of its ancestors (up to the governing include) is
// explicitly excluded — un-ticking a folder must also un-tick everything
// already visible beneath it, not just that exact path.
function godwitTreeNodeChecked(path, included, excluded) {
    var gov = godwitTreeGoverningInclude(path, included);
    if (!gov) { return false; }
    if (gov.path === path) { return true; }
    var ancestors = godwitTreeAncestorPaths(path);
    for (var i = 0; i < ancestors.length; i++) {
        if (godwitTreeFindByPath(excluded, ancestors[i])) { return false; }
    }
    return true;
}

// Returns new {included, excluded} arrays after toggling one node's
// checkbox. Never mutates the arrays passed in.
function godwitTreeToggle(node, included, excluded) {
    var path = node.path;
    var wasChecked = godwitTreeNodeChecked(path, included, excluded);
    var newIncluded = included.filter(function (n) { return n.path !== path; });
    var newExcluded = excluded.filter(function (n) { return n.path !== path; });
    if (wasChecked) {
        var gov = godwitTreeGoverningInclude(path, included);
        if (gov && gov.path === path) {
            // Explicit include removed — any exclusions nested under it are
            // now meaningless and are dropped too.
            newExcluded = newExcluded.filter(function (n) { return n.path.indexOf(path + '/') !== 0; });
        } else {
            // Implied via an ancestor — un-tick it explicitly.
            newExcluded.push({ path: path, is_dir: node.is_dir });
        }
    } else {
        var gov2 = godwitTreeGoverningInclude(path, included);
        if (!gov2) {
            // No included ancestor — this becomes its own include root.
            newIncluded.push({ path: path, is_dir: node.is_dir });
        }
        // else: it was excluded under an included ancestor — removing it
        // from newExcluded above already re-includes it.
    }
    return { included: newIncluded, excluded: newExcluded };
}
// GODWIT_TREE_END

var godwitJobSelections = {}; // job name -> {type, included, excluded}, the source of truth for every row's tree selection
var godwitPendingNewJobs = []; // jobs added this session, not yet saved
var godwitTreeIncluded = [];
var godwitTreeExcluded = [];
var godwitTreeRemote = '';
var godwitRemotesCache = []; // last remotes_list response, for the tree dialog's free-space comparison
var godwitTreeTargetName = null; // null = the Add-job dialog's own scratch selection
var godwitTreeScratch = { included: [], excluded: [] };

function godwitTreeSelectionFor(name) {
    return name === null ? godwitTreeScratch : (godwitJobSelections[name] || { included: [], excluded: [] });
}

function godwitTreeNodeLabel(entry) {
    return entry.name + (entry.is_dir ? '/' : '') + (entry.live ? ' ⚠ live data' : '');
}

function godwitTreeRenderChildren(container, parentPath, entries) {
    container.innerHTML = entries.map(function (e) {
        var path = parentPath ? parentPath + '/' + e.name : e.name;
        var checked = godwitTreeNodeChecked(path, godwitTreeIncluded, godwitTreeExcluded);
        var expandBtn = e.is_dir ? '<button type="button" class="godwit-tree-expand" data-path="' + esc(path) + '">▸</button> ' : '';
        return '<div class="godwit-tree-node" data-path="' + esc(path) + '" style="margin-left:16px">' +
            expandBtn +
            '<label><input type="checkbox" class="godwit-tree-check" data-path="' + esc(path) + '" data-isdir="' + (e.is_dir ? '1' : '0') + '"' + (checked ? ' checked' : '') + '> ' + esc(godwitTreeNodeLabel(e)) + '</label> ' +
            '<span class="godwit-tree-size" data-path="' + esc(path) + '"></span>' +
            (e.is_dir ? '<div class="godwit-tree-children" style="display:none"></div>' : '') +
            '</div>';
    }).join('');
}

// The tree's top level (parentPath === '') lists every share (v0.6.0: a
// selective job spans all of /mnt/user, not one share); everything deeper
// is a real tree_list()/tree_size() call, share-qualified by splitting the
// full path on its first '/'.
function godwitTreeLoad(parentPath, container) {
    if (parentPath === '') {
        return godwitApiCall('shares_list', {}).done(function (data) {
            if (data.error) { container.innerHTML = godwitErrorHtml(data.error); return; }
            var shares = data.shares || [];
            if (shares.length === 0) { container.innerHTML = 'No shares found — is the array started?'; return; }
            var entries = shares.map(function (s) { return { name: s.name, is_dir: true, live: s.live }; });
            godwitTreeRenderChildren(container, parentPath, entries);
        });
    }
    var split = godwitSplitTreePath(parentPath);
    return godwitApiCall('tree_list', { share: split.share, path: split.rest }).done(function (data) {
        if (data.error) { container.innerHTML = godwitErrorHtml(data.error); return; }
        godwitTreeRenderChildren(container, parentPath, data.entries || []);
    });
}

// Sums each *included root's* on-demand size (never a full-tree walk, per
// PLAN.md §4.4) rather than every visible node, since an included root's
// own total already covers everything ticked beneath it. Also compares
// against the target remote's free space (PLAN.md §4.4: "shown against
// the OneDrive free space ... with a warning before the 2 TB ceiling") —
// godwitRemotesCache is populated by godwitRemotesRefresh(), so this is a
// display-only comparison against whatever it last saw, never a fresh rc
// call of its own.
var GODWIT_ONEDRIVE_WARNING_BYTES = 2 * 1024 * 1024 * 1024 * 1024; // 2 TiB, PLAN.md §4.4

function godwitTreeFreeSpaceFor(remote) {
    var r = (godwitRemotesCache || []).find(function (x) { return x.name === remote; });
    return r && r.free !== null && r.free !== undefined ? r.free : null;
}

function godwitTreeUpdateTotal() {
    var totalEl = document.getElementById('tree-total-size');
    var freeEl = document.getElementById('tree-free-space');
    var free = godwitTreeFreeSpaceFor(godwitTreeRemote);
    var renderFree = function (total) {
        if (!freeEl) { return; }
        if (free === null) { freeEl.textContent = ''; return; }
        var nearCeiling = total > GODWIT_ONEDRIVE_WARNING_BYTES * 0.9 || total > free * 0.9;
        freeEl.innerHTML = ' — ' + fmtBytes(free) + ' free on ' + esc(godwitTreeRemote) +
            (nearCeiling ? ' <span style="color:red">— approaching the remote\'s free space or the 2 TiB ceiling</span>' : '');
    };
    if (godwitTreeIncluded.length === 0) { totalEl.textContent = fmtBytes(0); renderFree(0); return; }
    totalEl.textContent = 'calculating…';
    var total = 0;
    var pending = godwitTreeIncluded.length;
    godwitTreeIncluded.forEach(function (node) {
        var split = godwitSplitTreePath(node.path);
        godwitApiCall('tree_size', { share: split.share, path: split.rest }).done(function (data) {
            total += data.bytes || 0;
        }).always(function () {
            pending--;
            if (pending === 0) { totalEl.textContent = fmtBytes(total); renderFree(total); }
        });
    });
}

document.getElementById('tree-root').addEventListener('click', function (ev) {
    if (ev.target.classList.contains('godwit-tree-expand')) {
        var node = ev.target.closest('.godwit-tree-node');
        var children = node.querySelector('.godwit-tree-children');
        if (children.style.display === 'none') {
            children.style.display = 'block';
            ev.target.textContent = '▾';
            if (!children.dataset.loaded) {
                godwitTreeLoad(node.dataset.path, children).done(function () { children.dataset.loaded = '1'; });
            }
        } else {
            children.style.display = 'none';
            ev.target.textContent = '▸';
        }
        return;
    }
    if (ev.target.classList.contains('godwit-tree-check')) {
        var path = ev.target.dataset.path;
        var isDir = ev.target.dataset.isdir === '1';
        var result = godwitTreeToggle({ path: path, is_dir: isDir }, godwitTreeIncluded, godwitTreeExcluded);
        godwitTreeIncluded = result.included;
        godwitTreeExcluded = result.excluded;
        document.querySelectorAll('.godwit-tree-check').forEach(function (cb) {
            cb.checked = godwitTreeNodeChecked(cb.dataset.path, godwitTreeIncluded, godwitTreeExcluded);
        });
        godwitTreeUpdateTotal();
    }
});

function godwitTreeOpen(remote, targetName) {
    godwitTreeRemote = remote;
    godwitTreeTargetName = targetName;
    var sel = godwitTreeSelectionFor(targetName);
    godwitTreeIncluded = sel.included.slice();
    godwitTreeExcluded = sel.excluded.slice();
    document.getElementById('tree-root').innerHTML = 'Loading…';
    godwitTreeLoad('', document.getElementById('tree-root'));
    godwitTreeUpdateTotal();
    $('#tree-dialog').dialog('open');
}

document.getElementById('tree-done').addEventListener('click', function () {
    var sel = { included: godwitTreeIncluded, excluded: godwitTreeExcluded };
    if (godwitTreeTargetName === null) {
        godwitTreeScratch = sel;
        document.getElementById('job-add-selection-summary').textContent =
            godwitTreeIncluded.length + ' selected (' + godwitTreeExcluded.length + ' excluded)';
    } else {
        godwitJobSelections[godwitTreeTargetName] = { type: 'selective', included: sel.included, excluded: sel.excluded };
        godwitJobsRefresh();
    }
    $('#tree-dialog').dialog('close');
});

// Splits a full tree-selection path ("Kieren/Documents/Foo") into its share
// (top segment) and the rest — the tree spans every share (v0.6.0), but
// godwit_tree_list()/godwit_tree_node_size() are still per-share calls, so
// every API call point splits here rather than changing that server shape.
function godwitSplitTreePath(path) {
    var i = path.indexOf('/');
    return i === -1 ? { share: path, rest: '' } : { share: path.slice(0, i), rest: path.slice(i + 1) };
}

function godwitPopulateShareSelect() {
    return godwitApiCall('shares_list', {}).done(function (data) {
        var sel = document.getElementById('job-add-share');
        var prev = sel.value;
        sel.innerHTML = (data.shares || []).map(function (s) {
            return '<option value="' + esc(s.name) + '">' + esc(s.name) + (s.live ? ' ⚠ live data — not recommended' : '') + '</option>';
        }).join('');
        if ((data.shares || []).some(function (s) { return s.name === prev; })) { sel.value = prev; }
    });
}

document.getElementById('job-add-type').addEventListener('change', function () {
    var isSelective = this.value === 'selective';
    document.getElementById('job-add-selective').style.display = isSelective ? 'block' : 'none';
    document.getElementById('job-add-share-label').style.display = isSelective ? 'none' : 'inline';
});

document.getElementById('job-add-browse').addEventListener('click', function () {
    godwitTreeOpen(document.getElementById('job-add-remote').value, null);
});

document.getElementById('job-add').addEventListener('click', function () {
    var name = document.getElementById('job-add-name').value.trim();
    var type = document.getElementById('job-add-type').value;
    var share = document.getElementById('job-add-share').value;
    var remote = document.getElementById('job-add-remote').value;
    var msg = document.getElementById('job-add-message');
    if (!name || !remote || (type === 'share' && !share)) {
        msg.innerHTML = godwitErrorHtml('name and remote are required' + (type === 'share' ? ', and a share must be selected' : ''));
        return;
    }
    if (name in godwitJobSelections || godwitPendingNewJobs.some(function (j) { return j.name === name; })) {
        msg.innerHTML = godwitErrorHtml('a job named "' + name + '" already exists');
        return;
    }
    if (type === 'selective' && godwitTreeScratch.included.length === 0) {
        msg.innerHTML = godwitErrorHtml('browse and select at least one folder or file first');
        return;
    }
    var job = { name: name, remote: remote, mode: 'sync', enabled: true, transfers: 4, max_delete: 1000 };
    if (type === 'share') { job.share = share; }
    godwitPendingNewJobs.push(job);
    godwitJobSelections[name] = type === 'selective'
        ? { type: 'selective', included: godwitTreeScratch.included, excluded: godwitTreeScratch.excluded }
        : { type: 'share', included: [], excluded: [] };
    godwitTreeScratch = { included: [], excluded: [] };
    document.getElementById('job-add-selection-summary').textContent = '';
    document.getElementById('job-add-name').value = '';
    msg.innerHTML = '';
    $('#job-add-dialog').dialog('close');
    godwitJobsRefresh();
});

document.getElementById('godwit-jobs-table').addEventListener('click', function (ev) {
    if (ev.target.classList.contains('godwit-job-browse')) {
        var tr = ev.target.closest('tr');
        godwitTreeOpen(tr.dataset.remote, tr.dataset.name);
    }
});

function godwitJobRowHtml(j) {
    var sel = godwitJobSelections[j.name] || { type: j.type || 'share', included: j.included || [], excluded: j.excluded || [] };
    var pending = !('status_text' in j);
    var state = pending ? 'not yet saved' : (j.running
        ? 'running — ' + fmtBytes(j.progress.bytes) + ', ' + j.progress.files + ' files, ' +
          (j.progress.speed_bps !== null ? fmtBytes(j.progress.speed_bps) + '/s' : 'speed unknown') +
          ', ETA ' + fmtDuration(j.progress.eta_seconds)
        : j.status_text);
    var queue = pending || j.running ? '-' : (j.queue_position !== null ? j.queue_position : '-');
    var selectionCell = sel.type === 'selective'
        ? '<button type="button" class="godwit-job-browse" data-name="' + esc(j.name) + '">Browse (' + sel.included.length + ')</button>'
        : '<input type="text" class="godwit-job-excludes" value="' + esc((j.excludes || []).join(', ')) + '" size="30">';
    return '<tr data-name="' + esc(j.name) + '" data-share="' + esc(j.share || '') + '" data-remote="' + esc(j.remote) + '" data-maxdelete="' + (j.max_delete || 1000) + '">' +
        '<td>' + esc(j.name) + '</td>' +
        '<td>' + esc(j.remote) + '</td>' +
        '<td>' + esc(sel.type) + '</td>' +
        '<td><input type="checkbox" class="godwit-job-enabled"' + (j.enabled ? ' checked' : '') + '></td>' +
        '<td><select class="godwit-job-mode">' +
        '<option value="sync"' + (j.mode === 'sync' ? ' selected' : '') + '>sync</option>' +
        '<option value="copy"' + (j.mode === 'copy' ? ' selected' : '') + '>copy</option></select></td>' +
        '<td><input type="number" class="godwit-job-transfers" value="' + (j.transfers || 4) + '" size="3"></td>' +
        '<td>' + selectionCell + '</td>' +
        '<td>' + esc(state) + '</td>' +
        '<td>' + esc(String(queue)) + '</td>' +
        '</tr>';
}

function godwitJobsRefresh() {
    if (godwitActionPending) { return; }
    godwitApiCall('jobs_status', {})
        .done(function (data) {
            if (data.error) {
                document.getElementById('godwit-jobs-table').innerHTML = godwitErrorHtml(data.error);
                return;
            }
            var budgetHtml = (data.remotes || []).map(function (r) {
                // godwit_budget_cap_bytes() returns PHP_INT_MAX for a remote
                // with no configured cap (PLAN.md: OneDrive is unlimited by
                // default) — anything past 1e15 bytes (1 PB) is never a real
                // quota, so show "unlimited" rather than a meaningless
                // "744.5 MiB / 8.0 EiB (0.0%)".
                var unlimited = r.cap_bytes > 1e15;
                if (unlimited) {
                    return '<p>' + esc(r.remote) + ': ' + fmtBytes(r.used_24h_bytes) + ' used (no daily cap configured)</p>';
                }
                var pct = r.cap_bytes > 0 ? Math.min(100, r.used_24h_bytes / r.cap_bytes * 100) : 0;
                var throttled = r.throttled_until ? ' — Google upload limit, waiting until ' + new Date(r.throttled_until * 1000).toLocaleString() : '';
                return '<p>' + esc(r.remote) + ': ' + fmtBytes(r.used_24h_bytes) + ' / ' + fmtBytes(r.cap_bytes) +
                    ' (' + pct.toFixed(1) + '%)' + esc(throttled) +
                    '<br><div style="background:#ddd;width:300px;height:10px;"><div style="background:' +
                    (pct >= 100 ? '#c00' : '#2a6') + ';width:' + pct.toFixed(1) + '%;height:10px;"></div></div></p>';
            }).join('');
            document.getElementById('godwit-budget-bars').innerHTML = budgetHtml || '<p>No remotes configured.</p>';

            // Seed the selection map from the server only for jobs it doesn't
            // already know about — a job re-browsed this session must not be
            // clobbered by the next 15s poll.
            (data.jobs || []).forEach(function (j) {
                if (!(j.name in godwitJobSelections)) {
                    godwitJobSelections[j.name] = { type: j.type || 'share', included: j.included || [], excluded: j.excluded || [] };
                }
            });
            var rows = (data.jobs || []).concat(godwitPendingNewJobs).map(godwitJobRowHtml).join('');
            document.getElementById('godwit-jobs-table').innerHTML =
                '<table border="1" cellpadding="4"><tr><th>Name</th><th>Remote</th><th>Type</th><th>Enabled</th><th>Mode</th>' +
                '<th>Transfers</th><th>Excludes / Selection</th><th>Status</th><th>Queue</th></tr>' + rows + '</table>';

            if (!godwitJobsLoaded) {
                godwitWindowRows = godwitWindowsToRows(data.settings.windows);
                document.getElementById('godwit-profile').value = data.settings.profile;
                godwitRenderWindowsForm();
                godwitSyncAdvancedJsonFromForm();
                godwitJobsLoaded = true;
            }
            godwitUpdateProfileWarning();
            document.getElementById('godwit-pause').disabled = data.paused;
            document.getElementById('godwit-resume').disabled = !data.paused;
            document.getElementById('godwit-run-now').disabled = data.run_now;
        })
        .fail(function (xhr) {
            document.getElementById('godwit-jobs-table').innerHTML =
                '<p style="color:red">could not refresh jobs: ' + esc(xhr.status) + ' ' + esc(xhr.statusText) + '</p>';
        });
}

function godwitJobsSave() {
    var rows = document.querySelectorAll('#godwit-jobs-table tr[data-name]');
    var jobs = Array.prototype.map.call(rows, function (tr) {
        var name = tr.dataset.name;
        var sel = godwitJobSelections[name] || { type: 'share', included: [], excluded: [] };
        var job = {
            name: name,
            remote: tr.dataset.remote,
            enabled: tr.querySelector('.godwit-job-enabled').checked,
            mode: tr.querySelector('.godwit-job-mode').value,
            transfers: parseInt(tr.querySelector('.godwit-job-transfers').value, 10) || 4,
            max_delete: parseInt(tr.dataset.maxdelete, 10) || 1000,
            type: sel.type,
        };
        if (sel.type === 'selective') {
            job.included = sel.included;
            job.excluded = sel.excluded;
            job.excludes = [];
        } else {
            job.share = tr.dataset.share;
            job.excludes = tr.querySelector('.godwit-job-excludes').value.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
        }
        return job;
    });
    var btn = document.getElementById('godwit-jobs-save');
    godwitRunAction('jobs_save', { jobs: JSON.stringify(jobs) }, btn, 'Saving…', function (data) {
        if (data.error) { godwitShowJobsMessage(godwitErrorHtml(data.error)); return; }
        godwitPendingNewJobs = [];
        // A saved job's type/included/excluded are now the server's own
        // truth — clear this tab's overrides so the next poll re-seeds
        // from data.jobs instead of this tab's memory silently overriding
        // the server (and every other tab/session) indefinitely.
        godwitJobSelections = {};
        godwitShowJobsMessage('<p style="color:green">Jobs saved.</p>');
    }, godwitShowJobsMessage, godwitJobsRefresh);
}

function godwitSettingsSave() {
    var errors = [];
    godwitWindowRows.forEach(function (row, i) {
        var err = godwitValidateRow(row);
        if (err) { errors.push('Window ' + (i + 1) + ': ' + err); }
    });
    document.querySelectorAll('.godwit-window-row-error').forEach(function (el, i) {
        el.textContent = godwitValidateRow(godwitWindowRows[i]) || '';
    });
    if (errors.length) {
        godwitShowJobsMessage(godwitErrorHtml(errors.join('; ')));
        return;
    }
    var settings = { windows: godwitRowsToWindows(godwitWindowRows), profile: document.getElementById('godwit-profile').value };
    var btn = document.getElementById('godwit-settings-save');
    godwitRunAction('settings_save', { settings: JSON.stringify(settings) }, btn, 'Saving…', function (data) {
        if (data.error) { godwitShowJobsMessage(godwitErrorHtml(data.error)); return; }
        godwitShowJobsMessage('<p style="color:green">Windows/speed saved.</p>');
    }, godwitShowJobsMessage, godwitJobsRefresh);
}

document.getElementById('godwit-jobs-save').addEventListener('click', godwitJobsSave);
document.getElementById('godwit-settings-save').addEventListener('click', godwitSettingsSave);
document.getElementById('godwit-windows-add').addEventListener('click', function () {
    godwitWindowRows.push({ days: [0, 1, 2, 3, 4, 5, 6], start: '22:00', end: '06:00', limit_mbit: 100 });
    godwitRenderWindowsForm();
    godwitSyncAdvancedJsonFromForm();
});
document.getElementById('godwit-windows-json-apply').addEventListener('click', function () {
    var el = document.getElementById('godwit-windows-json');
    var errEl = document.getElementById('godwit-windows-json-error');
    try {
        var windows = JSON.parse(el.value);
        if (!Array.isArray(windows)) { throw new Error('must be a JSON array'); }
        windows.forEach(function (w, i) {
            if (!Array.isArray(w.days)) { throw new Error('window ' + (i + 1) + ' needs a days array'); }
        });
        godwitWindowRows = godwitWindowsToRows(windows);
        errEl.textContent = '';
        godwitRenderWindowsForm();
        godwitUpdateProfileWarning();
    } catch (e) {
        errEl.textContent = 'Invalid JSON: ' + e.message;
    }
});
// Switching to a named profile sets a sensible default window ceiling —
// ponytail: 70% of the profile's upstream, comfortably under the 80%
// warning threshold rather than landing exactly on it. Kieren can still
// type any number by hand afterwards; this only fires on an actual
// dropdown change, never on page load, so it can't clobber a saved value.
// "custom" leaves whatever is already in the windows form untouched.
document.getElementById('godwit-profile').addEventListener('change', function () {
    var upstream = godwitProfileUpstream[this.value];
    if (upstream) {
        godwitWindowRows.forEach(function (r) { r.limit_mbit = Math.round(upstream * 0.7); });
        godwitRenderWindowsForm();
        godwitSyncAdvancedJsonFromForm();
    }
    godwitUpdateProfileWarning();
});
document.getElementById('godwit-run-now').addEventListener('click', function () {
    godwitRunAction('run_now', {}, document.getElementById('godwit-run-now'), 'Starting…', function (data) {
        if (data.error) { godwitShowJobsMessage(godwitErrorHtml(data.error)); return; }
        godwitShowJobsMessage('<p style="color:green">Run now started — the queue will run regardless of the window until it drains or the budget is hit.</p>');
    }, godwitShowJobsMessage, godwitJobsRefresh);
});
