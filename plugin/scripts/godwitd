#!/usr/bin/php
<?php
/**
 * Godwit daemon — Phase 1. Starts and supervises a single bundled `rclone
 * rcd` process, restarting it with backoff if it dies, and records a
 * heartbeat (start time, rcd pid, listener, rc/noop + core/version results)
 * to SQLite every 15s. No remotes, no jobs, no uploads yet.
 *
 * Paths are overridable via GODWIT_PIDFILE / GODWIT_LOG / GODWIT_RUNDIR /
 * GODWIT_STATEDIR / GODWIT_CFGDIR / GODWIT_RCLONE so tests can exercise the
 * argv builder without touching real paths. This file itself is not
 * exercised end-to-end by tests/run.php (it supervises a real child
 * process) — only its pure building blocks in lib.php are.
 */
declare(strict_types=1);

require __DIR__ . '/lib.php';

$pidFile = getenv('GODWIT_PIDFILE') ?: '/var/run/godwit.pid';
$logFile = getenv('GODWIT_LOG') ?: '/var/log/godwit.log';
$runDir = getenv('GODWIT_RUNDIR') ?: '/var/run/godwit';
$stateDir = getenv('GODWIT_STATEDIR') ?: '/mnt/cache/appdata/godwit';
$cfgDir = getenv('GODWIT_CFGDIR') ?: '/boot/config/plugins/godwit';
$rcloneBin = getenv('GODWIT_RCLONE') ?: dirname(__DIR__) . '/bin/rclone';
$cacheMountDir = getenv('GODWIT_CACHE_MOUNT_DIR') ?: '/mnt/cache';

/**
 * Tries a unix socket listener first; if rcd exits or the socket never
 * appears within ~2s, falls back to 127.0.0.1 on a free port with generated
 * credentials. Returns ['proc' => resource, 'listener' => array] on success,
 * null if even the fallback failed to start.
 */
function godwit_start_rcd(string $rcloneBin, string $configPath, string $runDir, string $rcdLogFile, string $logFile): ?array
{
    $sockPath = $runDir . '/rcd.sock';
    @unlink($sockPath);
    // Every listener now carries generated credentials, unix included — see
    // godwit_rcd_argv()'s docblock: rclone's rc auth gate is not exempted by
    // unix-socket transport, and config/*+operations/about (Phase 2) are not
    // NoAuth commands. The socket directory's own permissions (0700,
    // godwit-only) still gate who can even attempt a connection.
    $unixListener = [
        'type' => 'unix',
        'path' => $sockPath,
        'user' => godwit_generate_credential(),
        'pass' => godwit_generate_credential(),
    ];
    $proc = godwit_spawn_rcd($rcloneBin, $configPath, $unixListener, $rcdLogFile);

    for ($i = 0; $i < 20; $i++) {
        usleep(100000);
        if (file_exists($sockPath)) {
            godwit_log($logFile, "rcd listening on unix socket $sockPath");
            godwit_write_rc_credentials($runDir, $unixListener);
            return ['proc' => $proc, 'listener' => $unixListener];
        }
        $status = proc_get_status($proc);
        if (!$status['running']) {
            break;
        }
    }

    godwit_log($logFile, 'unix socket listener did not come up — falling back to tcp');
    proc_terminate($proc);
    proc_close($proc);

    $tcpListener = [
        'type' => 'tcp',
        'host' => '127.0.0.1',
        'port' => godwit_free_tcp_port(),
        'user' => godwit_generate_credential(),
        'pass' => godwit_generate_credential(),
    ];
    $proc = godwit_spawn_rcd($rcloneBin, $configPath, $tcpListener, $rcdLogFile);
    usleep(500000);
    $status = proc_get_status($proc);
    if (!$status['running']) {
        proc_close($proc);
        godwit_log($logFile, 'tcp fallback listener failed to start');
        return null;
    }
    godwit_log($logFile, "rcd listening on tcp {$tcpListener['host']}:{$tcpListener['port']}");
    godwit_write_rc_credentials($runDir, $tcpListener);
    return ['proc' => $proc, 'listener' => $tcpListener];
}

function godwit_spawn_rcd(string $rcloneBin, string $configPath, array $listener, string $rcdLogFile)
{
    $argv = godwit_rcd_argv($rcloneBin, $configPath, $listener, $rcdLogFile);
    $descriptors = [0 => ['pipe', 'r'], 1 => ['file', $rcdLogFile, 'a'], 2 => ['file', $rcdLogFile, 'a']];
    // Credentials go in via env, never argv — see godwit_rcd_env()'s
    // docblock (a bare --rc-user=/--rc-pass= would be visible to any local
    // process via `ps aux` / /proc/<pid>/cmdline). proc_open() replaces the
    // whole environment when one is supplied, so this merges onto the
    // current process's env rather than handing the child a stripped one.
    $env = array_merge(getenv(), godwit_rcd_env($listener));
    $proc = proc_open($argv, $descriptors, $pipes, null, $env);
    if ($proc === false) {
        throw new \RuntimeException('failed to spawn rclone rcd');
    }
    fclose($pipes[0]);
    return $proc;
}

// Refuse to run at all if /mnt/cache isn't a real mountpoint yet — a boot-
// time invocation before the cache pool mounts would otherwise create the
// state dir on the RAM rootfs, silently covered by the later real mount.
// This should never actually trigger in production now that the plg only
// starts godwitd via the `started` event hook or an already-array-started
// install, but it stays as the last line of defence. GODWIT_ASSUME_CACHE_MOUNTED
// ('1'/'0') overrides the real check for tests.
$assumeCacheMounted = getenv('GODWIT_ASSUME_CACHE_MOUNTED');
if (!godwit_resolve_cache_mounted($assumeCacheMounted === false ? null : $assumeCacheMounted, $cacheMountDir)) {
    godwit_log($logFile, "ERROR: $cacheMountDir is not a mountpoint — refusing to start (would create the state dir on the rootfs). Will start via the 'started' event hook once the array is up.");
    exit(1);
}

file_put_contents($pidFile, getmypid() . PHP_EOL);
godwit_log($logFile, 'godwitd started (pid ' . getmypid() . ')');

if (!is_dir($cfgDir)) {
    mkdir($cfgDir, 0755, true);
}
$configPath = $cfgDir . '/rclone.conf';
if (!file_exists($configPath)) {
    touch($configPath);
}
// /boot/config is a vfat mount on the host — chmod() there is a no-op (mode
// comes from the mount's fmask/dmask) and PHP logs an EPERM warning on every
// daemon start if not suppressed. Best-effort only; the actual mode is
// whatever the mount enforces, not necessarily 0600.
@chmod($configPath, 0600);

if (!is_dir($runDir)) {
    mkdir($runDir, 0700, true);
}

if (!@is_dir($stateDir) && !@mkdir($stateDir, 0755, true)) {
    godwit_log($logFile, "WARNING: could not create state dir $stateDir — heartbeat will not be recorded");
}
$dbPath = $stateDir . '/godwit.db';
$db = null;
try {
    if (is_dir($stateDir)) {
        $db = godwit_open_db($dbPath);
    }
} catch (\Throwable $e) {
    godwit_log($logFile, 'WARNING: could not open heartbeat db: ' . $e->getMessage());
}

$running = true;
pcntl_async_signals(true);
pcntl_signal(SIGTERM, function () use (&$running) {
    $running = false;
});

date_default_timezone_set(godwit_resolve_timezone(getenv('GODWIT_TZ') ?: null));
godwit_log($logFile, 'effective timezone: ' . date_default_timezone_get());

if ($db !== null) {
    godwit_open_budget_table($db);
    godwit_open_throttle_table($db);
    godwit_open_job_runs_table($db);
    godwit_open_notify_state_table($db);
    // A restart of godwitd/rcd always loses whatever rc job was in flight —
    // rcd's job state lives in that process's memory only. Close out any run
    // row left open by the previous process; nothing further is needed to
    // "requeue" it, since $activeJobs below starts empty and the normal
    // selection pass below will pick the job up again on its own (sync is
    // idempotent — a re-run only transfers what's still actually
    // missing/changed).
    $interrupted = godwit_interrupt_open_runs($db, time());
    foreach ($interrupted as $row) {
        godwit_log($logFile, "requeue after restart: {$row['job_name']} was interrupted mid-run, will restart");
    }
}

$daemonStartTs = time();
$rcdLogFile = $runDir . '/rcd.log';
$rcd = godwit_start_rcd($rcloneBin, $configPath, $runDir, $rcdLogFile, $logFile);
$backoffSeconds = 1;
$rcdStartedAt = time();
$lastHeartbeat = 0;
$lastTrim = 0;
// 0 forces a health check on the very first loop tick (startup), not an
// hour in — host verification (and Kieren, after a fresh install) should
// not have to wait an hour to see a remote's status.
$lastHealthCheck = 0;
$healthCheckIntervalSeconds = (int) (getenv('GODWIT_HEALTH_INTERVAL') ?: 3600);
$checkNowMarker = $runDir . '/check-now';

// === Phase 3: Jobs, budget, windows ========================================
$jobs = godwit_load_jobs($cfgDir);
$settings = godwit_load_settings($cfgDir);
$jobsChangedMarker = $runDir . '/jobs-changed';
$runNowMarker = $runDir . '/run-now';
$pausedMarker = $runDir . '/paused';
$lastJobsReload = time();
$lastRetention = 0;
$lastLedgerTrim = 0;
$currentBwlimitMbit = null;
$activeJobs = []; // jobName => ['jobid','remote','run_id','started_ts','group','last_bytes','stop_reason']
// jobName => true while godwit_job_budget_gated() holds it back (v0.4.2) —
// lets the "held back" log line fire once per gated spell instead of once
// per 15s tick; cleared the moment the job is no longer gated (started, or
// freed up enough budget).
$budgetGateLogged = [];
// Marks when the current window (or "Run now" override) began — reset
// whenever start-gating transitions from closed to open. godwit_select_next_jobs()
// uses this to tell "already finished this session, don't re-select it" apart
// from "never run" — without it, a job that just completed and dropped out of
// $activeJobs looks identical to one that never started, and the queue would
// loop on whichever job sorts first for its remote (Filing Cabinet, always)
// instead of ever advancing to the next one.
// If godwitd is (re)starting into an already-open window (or a "Run now"
// left running across the restart), seed the session clock from the
// window's real start rather than "now" — otherwise a restart mid-window
// would make every job that already completed earlier that same window
// look like it had never run this session (see godwit_window_start_ts()).
$startupWindow = godwit_active_window($settings['windows'], new \DateTimeImmutable('now'));
$startupRunNow = file_exists($runDir . '/run-now');
if ($startupWindow !== null) {
    $sessionStartTs = godwit_window_start_ts($startupWindow, new \DateTimeImmutable('now'));
    $startGateWasOpen = true;
} elseif ($startupRunNow) {
    // No way to recover when the override itself started — start of day is
    // a safe, conservative floor (never older than "today"), which is far
    // better than 0 (which would treat every completed run, ever, as part
    // of this session and refuse to restart any of them).
    $sessionStartTs = (new \DateTimeImmutable('today'))->getTimestamp();
    $startGateWasOpen = true;
} else {
    $sessionStartTs = 0;
    $startGateWasOpen = false;
}

while ($running) {
    sleep(1);
    $now = time();

    if ($rcd !== null) {
        $status = proc_get_status($rcd['proc']);
        if (!$status['running']) {
            godwit_log($logFile, "rcd exited (pid {$status['pid']}) — restarting in {$backoffSeconds}s");
            proc_close($rcd['proc']);
            $rcd = null;
            // A mid-loop rcd crash loses any in-flight rc job exactly like a
            // full godwitd restart does (job state lives in rcd's own
            // process memory), but without this, $activeJobs would keep
            // tracking a jobid that no longer means anything to the fresh
            // rcd about to be spawned — rclone's job IDs are a per-process
            // counter starting at 1, so the very next job started could be
            // silently misattributed to the stale entry's remote/run row.
            // Close out any open run rows and clear the in-memory tracking
            // the same way startup's godwit_interrupt_open_runs() does, so
            // the next selection pass just requeues them (sync is
            // idempotent).
            if ($db !== null && count($activeJobs) > 0) {
                $interrupted = godwit_interrupt_open_runs($db, $now);
                foreach ($interrupted as $row) {
                    godwit_log($logFile, "requeue after rcd crash: {$row['job_name']} was interrupted mid-run, will restart");
                }
                $activeJobs = [];
            }
            // The fresh rcd process starts with no bwlimit applied at all —
            // without resetting this, "only re-issue on change" below would
            // never re-apply it (the in-memory value hasn't changed), so a
            // crash mid-window would silently go back to unlimited upload
            // until the next window transition.
            $currentBwlimitMbit = null;
            sleep($backoffSeconds);
            $backoffSeconds = min($backoffSeconds * 2, 60);
        } elseif ($now - $rcdStartedAt > 60) {
            $backoffSeconds = 1;
        }
    }

    if ($rcd === null && $running) {
        $rcd = godwit_start_rcd($rcloneBin, $configPath, $runDir, $rcdLogFile, $logFile);
        $rcdStartedAt = time();
        if ($rcd === null) {
            // Both the unix-socket attempt and the tcp fallback failed to
            // start (e.g. a broken binary) — back off the same as a crash,
            // or this loop retries every second forever with no delay.
            godwit_log($logFile, "rcd failed to start on both listeners — retrying in {$backoffSeconds}s");
            sleep($backoffSeconds);
            $backoffSeconds = min($backoffSeconds * 2, 60);
        }
    }

    if ($db !== null && $rcd !== null && $now - $lastHeartbeat >= 15) {
        $status = proc_get_status($rcd['proc']);
        $noop = godwit_rc_call($rcd['listener'], 'rc/noop');
        $version = godwit_rc_call($rcd['listener'], 'core/version');
        $listenerDesc = $rcd['listener']['type'] === 'unix'
            ? 'unix:' . $rcd['listener']['path']
            : 'tcp:' . $rcd['listener']['host'] . ':' . $rcd['listener']['port'];
        godwit_record_heartbeat(
            $db,
            $now,
            $daemonStartTs,
            $status['pid'],
            $listenerDesc,
            $noop !== null,
            $version['version'] ?? null
        );
        $lastHeartbeat = $now;
    }

    if ($db !== null && $now - $lastTrim >= 3600) {
        godwit_trim_heartbeat($db, $now);
        $lastTrim = $now;
    }

    // Remote health checks: hourly, on the very first tick, or whenever the
    // web page drops a marker file for an on-demand check (its own "Test
    // connection" / status refresh action). Read-only rc calls only
    // (operations/about) — must never wake the array pool on its own, and
    // never writes to Drive/OneDrive in this phase.
    $checkNowRequested = file_exists($checkNowMarker);
    if ($db !== null && $rcd !== null && ($checkNowRequested || $now - $lastHealthCheck >= $healthCheckIntervalSeconds)) {
        if ($checkNowRequested) {
            @unlink($checkNowMarker);
        }
        $remotes = godwit_list_remotes($rcd['listener']);
        if ($remotes !== null) {
            foreach ($remotes as $remote) {
                $result = godwit_run_health_check($db, $rcd['listener'], $remote['name']);
                godwit_log($logFile, "health check: {$remote['name']} -> {$result['status']}");
            }
        }
        $lastHealthCheck = $now;
    }

    // === Phase 3 tick: reload config, gate on window/pause, poll active jobs, ===
    // === start new ones within budget, retention purge once a day. ===========
    if (file_exists($jobsChangedMarker) || $now - $lastJobsReload >= 30) {
        @unlink($jobsChangedMarker);
        $jobs = godwit_load_jobs($cfgDir);
        $settings = godwit_load_settings($cfgDir);
        $lastJobsReload = $now;
    }

    if ($db !== null && $rcd !== null) {
        $paused = file_exists($pausedMarker);
        $runNow = file_exists($runNowMarker);
        $nowDt = new \DateTimeImmutable('now');
        $window = godwit_active_window($settings['windows'], $nowDt);

        // core/bwlimit is process-global (one shared upload pipe, §4.5) — only
        // re-issued when the desired rate actually changes, not every tick.
        $desiredBwlimitMbit = $window !== null
            ? (float) $window['limit_mbit']
            : ($runNow ? godwit_run_now_limit_mbit($settings['windows']) : null);
        if ($desiredBwlimitMbit !== null && $desiredBwlimitMbit !== $currentBwlimitMbit) {
            godwit_rc_call_params($rcd['listener'], 'core/bwlimit', ['rate' => godwit_bwlimit_rc_value($desiredBwlimitMbit)], 15);
            godwit_log($logFile, 'bwlimit set to ' . godwit_format_mbit_and_mib($desiredBwlimitMbit));
            $currentBwlimitMbit = $desiredBwlimitMbit;
        }

        $startGateOpen = $window !== null || $runNow;
        if ($startGateOpen && !$startGateWasOpen) {
            $sessionStartTs = $now;
        }
        $startGateWasOpen = $startGateOpen;

        // --- Start new jobs: only inside a window, or under the "Run now"
        // override (D15), never both gates bypassed at once by accident —
        // $runNow only widens *when* jobs may start, budget/throttle/overlap
        // guards below are identical either way.
        if (!$paused && $startGateOpen) {
            $activeRemotes = array_values(array_unique(array_map(fn ($aj) => $aj['remote'], $activeJobs)));
            $lastRuns = [];
            foreach ($jobs as $job) {
                $lastRuns[$job['name']] = godwit_last_job_run($db, $job['name']);
            }
            // Per-remote cap/remaining, computed once up front so the
            // budget-threshold gate (below) and the actual start loop see
            // the same numbers, and so the ledger isn't queried twice per
            // remote per tick.
            $remoteBudget = [];
            foreach (array_values(array_unique(array_column($jobs, 'remote'))) as $remote) {
                $cap = (int) ($settings['budget_caps'][$remote] ?? godwit_default_budget_cap_bytes());
                $remoteBudget[$remote] = ['cap' => $cap, 'remaining' => godwit_remaining_budget($cap, godwit_ledger_used_24h($db, $remote, $now))];
            }
            // v0.4.2 minimum-budget-threshold gate: a job resuming known-
            // outstanding work (its last run ended by hitting the budget
            // cap) waits for real headroom instead of restarting on every
            // trickle of freed budget — see godwit_job_budget_gated()'s
            // docblock. Computed and passed into godwit_select_next_jobs()
            // itself (not filtered out of $candidates below) so a gated
            // job never reserves its remote and blocks a sibling job on
            // the same remote from getting a turn this tick.
            $gatedJobNames = [];
            foreach ($jobs as $job) {
                $budget = $remoteBudget[$job['remote']] ?? ['cap' => 0, 'remaining' => 0];
                $minFraction = (float) ($settings['budget_min_fractions'][$job['remote']] ?? GODWIT_MIN_BUDGET_FRACTION);
                if (godwit_job_budget_gated($lastRuns[$job['name']] ?? null, $budget['cap'], $budget['remaining'], $minFraction)) {
                    $gatedJobNames[] = $job['name'];
                    if (!isset($budgetGateLogged[$job['name']])) {
                        $threshold = godwit_min_budget_threshold_bytes($budget['cap'], $minFraction);
                        godwit_log($logFile, "job \"{$job['name']}\" held back — {$job['remote']}'s remaining budget ({$budget['remaining']} bytes) is below the resume threshold ($threshold bytes) for a job resuming a budget stop");
                        $budgetGateLogged[$job['name']] = true;
                    }
                } else {
                    unset($budgetGateLogged[$job['name']]);
                }
            }
            $candidates = godwit_select_next_jobs($jobs, $activeRemotes, $lastRuns, $sessionStartTs, $gatedJobNames);
            foreach ($candidates as $job) {
                $remote = $job['remote'];
                if (godwit_throttled_until($db, $remote, $now) !== null) {
                    continue;
                }
                $cap = $remoteBudget[$remote]['cap'];
                $remaining = $remoteBudget[$remote]['remaining'];
                if ($remaining <= 0) {
                    $n = godwit_budget_reached_notification($db, $remote, date('Y-m-d'));
                    if ($n !== null) {
                        godwit_notify($n['subject'], $n['description'], $n['importance']);
                    }
                    continue;
                }
                try {
                    $fs = godwit_build_job_fs($job);
                    godwit_assert_job_direction($fs);
                } catch (\Throwable $e) {
                    godwit_log($logFile, "job \"{$job['name']}\" refused to start — invalid job definition: " . $e->getMessage());
                    continue;
                }
                $safeName = preg_replace('/[^A-Za-z0-9_-]/', '_', $job['name']);
                $filterFile = $runDir . '/filter-' . $safeName . '.txt';
                godwit_write_filter_file($filterFile, godwit_compile_filter_rules($job));
                $backupDirFs = ($job['mode'] ?? 'sync') === 'sync' ? godwit_backup_dir_fs($job, date('Y-m-d')) : null;
                // Soft window stop (§4.5): a window-started job gets MaxDuration
                // set to the seconds left in *this* window, with CutoffMode
                // CAUTIOUS — rclone itself then stops picking up new files at
                // the boundary and lets whatever's already in flight finish,
                // so a 134 GB upload started at 05:00 is never hard-killed at
                // 06:00. ponytail: MaxDuration is fixed at job start and does
                // not adapt if the window is edited mid-run; the job just runs
                // to the duration computed here — acceptable since windows
                // change rarely and the next tick's start recomputes it fresh.
                // A "Run now" job gets no MaxDuration — it runs until the
                // queue drains or the budget is hit, per D15.
                $maxDuration = ($window !== null && !$runNow) ? godwit_seconds_to_window_end($window, $nowDt) : null;
                $params = godwit_build_sync_params($job, $fs, $filterFile, $remaining, $backupDirFs, $maxDuration);
                $resp = godwit_rc_call_params($rcd['listener'], godwit_sync_rc_path($job['mode'] ?? 'sync'), $params, 15);
                if ($resp === null || !isset($resp['jobid'])) {
                    godwit_log($logFile, "job \"{$job['name']}\" failed to start — rcd did not answer or returned no jobid");
                    continue;
                }
                $jobid = $resp['jobid'];
                $runId = godwit_start_job_run($db, $job['name'], $remote, $now);
                $activeJobs[$job['name']] = [
                    'jobid' => $jobid,
                    'remote' => $remote,
                    'run_id' => $runId,
                    'started_ts' => $now,
                    'group' => 'job/' . $jobid,
                    'last_bytes' => 0,
                    'stop_reason' => null,
                    'transfers' => (int) ($job['transfers'] ?? 4),
                    // The exact MaxTransfer passed to this job at start
                    // (v0.4.3) — fed to godwit_classify_job_outcome() as a
                    // fallback signal for the masked-cutoff case, since
                    // godwitd is the only place that actually knows it.
                    'max_transfer' => $remaining,
                ];
                godwit_log($logFile, "job started: {$job['name']} -> {$fs['dstFs']} (rc jobid $jobid, remaining budget $remaining bytes)");
            }
        }

        // --- Poll active jobs: job/status (finished/error) + core/stats
        // (bytes/files/errors), every tick.
        foreach ($activeJobs as $name => $aj) {
            $status = godwit_rc_call_params($rcd['listener'], 'job/status', ['jobid' => $aj['jobid']], 15);
            $stats = godwit_rc_call_params($rcd['listener'], 'core/stats', ['group' => $aj['group']], 15);
            $bytes = (int) ($stats['bytes'] ?? $aj['last_bytes']);
            $delta = $bytes - $aj['last_bytes'];
            if ($delta > 0) {
                godwit_record_ledger_delta($db, $aj['remote'], $now, $delta);
            }
            $activeJobs[$name]['last_bytes'] = $bytes;
            $etaSeconds = isset($stats['eta']) && is_numeric($stats['eta']) ? (int) $stats['eta'] : null;
            $speedBps = isset($stats['speed']) && is_numeric($stats['speed']) ? (int) $stats['speed'] : null;
            godwit_update_job_run_progress($db, $aj['run_id'], $bytes, (int) ($stats['transfers'] ?? 0), (int) ($stats['errors'] ?? 0), $etaSeconds, $speedBps);

            if ($status === null || empty($status['finished'])) {
                // §4.3's second line of defence: MaxTransfer was set to the
                // remaining budget at job start, but Phase 1's spike found it
                // can overshoot by up to transfers × average file size — so
                // the daemon actively stops a still-running job the moment
                // its remote's rolling-24h ledger reaches the cap, rather
                // than trusting rclone's own cutoff alone. job/stop is
                // cooperative (not a kill), so an in-flight chunk still
                // finishes; issued every tick until the job actually reports
                // finished, which is harmless — rclone treats a repeat
                // job/stop on an already-stopping job as a no-op.
                $cap = (int) ($settings['budget_caps'][$aj['remote']] ?? godwit_default_budget_cap_bytes());
                if (godwit_remaining_budget($cap, godwit_ledger_used_24h($db, $aj['remote'], $now)) <= 0) {
                    godwit_rc_call_params($rcd['listener'], 'job/stop', ['jobid' => $aj['jobid']], 15);
                    $activeJobs[$name]['stop_reason'] = 'budget';
                    godwit_log($logFile, "job \"$name\" stopped mid-run — {$aj['remote']}'s daily budget was reached");
                }
                continue;
            }
            $errorMsg = trim((string) ($status['error'] ?? ''));
            $files = (int) ($stats['transfers'] ?? 0);
            $errors = (int) ($stats['errors'] ?? 0);
            // godwit_classify_job_outcome() reads rclone's own fixed cutoff
            // error text (ground-truthed against the bundled binary) rather
            // than inferring the reason from whatever the scheduler happens
            // to be doing at poll time — an earlier version guessed "window"
            // whenever no window was active the moment the finish was
            // observed, which misclassified (and alerted on) a job that
            // simply finished a few seconds after its window closed.
            $stoppedForBudget = ($aj['stop_reason'] ?? null) === 'budget';
            $outcome = godwit_classify_job_outcome($errorMsg, $stoppedForBudget, $bytes, $aj['max_transfer'] ?? null);
            if ($outcome === 'throttled') {
                $wasThrottled = godwit_throttled_until($db, $aj['remote'], $now) !== null;
                godwit_mark_throttled($db, $aj['remote'], $now + 86400);
                $n = godwit_throttled_notification($aj['remote'], $wasThrottled);
                if ($n !== null) {
                    godwit_notify($n['subject'], $n['description'], $n['importance']);
                }
            } elseif ($outcome === 'error') {
                $n = godwit_job_error_notification($name, $errorMsg);
                godwit_notify($n['subject'], $n['description'], $n['importance']);
            } elseif ($outcome === 'budget' || $outcome === 'window') {
                // Two clean-cutoff error baselines, ground-truthed locally
                // against the bundled binary at Transfers up to 8 (see
                // godwit_cap_stop_notification()): a budget stop — whether
                // rclone's own graceful MaxTransfer cutoff or godwitd's own
                // mid-run job/stop — costs up to one error per in-flight
                // transfer slot (each worker independently discovers the
                // cutoff/cancellation when it next tries to start a file);
                // MaxDuration's fatal cutoff costs exactly 0.
                $baselineErrors = $outcome === 'window' ? 0 : $aj['transfers'];
                $resumeLabel = godwit_next_window_start_label($settings['windows'], $nowDt);
                $n = godwit_cap_stop_notification($name, $outcome, $bytes, $errors, $baselineErrors, $resumeLabel);
                godwit_notify($n['subject'], $n['description'], $n['importance']);
            }
            godwit_finish_job_run($db, $aj['run_id'], $now, $bytes, $files, $errors, $outcome);
            if ($outcome === 'completed') {
                $n = godwit_first_seed_notification($db, $name);
                if ($n !== null) {
                    godwit_notify($n['subject'], $n['description'], $n['importance']);
                }
            }
            godwit_log($logFile, "job finished: $name -> $outcome ($bytes bytes, $files files, $errors errors)");
            unset($activeJobs[$name]);
        }

        // --- "Run now" clears itself once the queue has drained (nothing
        // active and nothing left eligible to start) — scheduled runs
        // thereafter follow the normal window (D15).
        if ($runNow && count($activeJobs) === 0) {
            // Rebuilt fresh (not reused from the start-new-jobs block above,
            // which only runs when !$paused) and passed through the same
            // $lastRuns/$sessionStartTs session-awareness as the real
            // selection — without this the drained check saw every
            // completed job as "never run" and could never observe an empty
            // queue, so the run-now marker was never removed.
            $lastRunsForDrainCheck = [];
            foreach ($jobs as $job) {
                $lastRunsForDrainCheck[$job['name']] = godwit_last_job_run($db, $job['name']);
            }
            $stillEligible = godwit_select_next_jobs($jobs, [], $lastRunsForDrainCheck, $sessionStartTs);
            if (count($stillEligible) === 0) {
                @unlink($runNowMarker);
                godwit_log($logFile, '"Run now" queue drained — reverting to the normal window schedule');
            }
        }

        // --- Version retention purge (§ item 6): once a day, whole
        // date directories only, every path re-validated by
        // godwit_purge_call_params()/godwit_assert_purge_path() immediately
        // before the rc call — never a hand-built string.
        if ($now - $lastRetention >= 86400) {
            $retainDays = (int) ($settings['retention_days'] ?? godwit_default_retention_days());
            foreach ($jobs as $job) {
                if (empty($job['enabled'])) {
                    continue;
                }
                $versionsFs = $job['remote'] . ':godwit/_versions/' . $job['share'];
                $listResult = godwit_list_versions_dirs($rcd['listener'], $versionsFs);
                if (isset($listResult['error'])) {
                    godwit_log($logFile, "retention purge: operations/list failed for $versionsFs: {$listResult['error']}");
                    continue;
                }
                $candidates = godwit_versions_purge_candidates($listResult['dirs'], $retainDays, $nowDt);
                foreach ($candidates as $dateDir) {
                    try {
                        $purgeParams = godwit_purge_call_params($job['remote'], $job['share'], $dateDir);
                    } catch (\Throwable $e) {
                        godwit_log($logFile, 'retention purge refused (safety check failed): ' . $e->getMessage());
                        continue;
                    }
                    godwit_rc_call_params($rcd['listener'], 'operations/purge', $purgeParams, 60);
                    godwit_log($logFile, "retention purge: {$job['remote']}:godwit/_versions/{$job['share']}/$dateDir");
                }
            }
            $lastRetention = $now;
        }

        // Its own counter, deliberately not $lastTrim (shared by the
        // heartbeat trim above, which runs earlier in this same tick and
        // always resets $lastTrim = $now first — sharing it here made this
        // condition permanently false, so the ledger never trimmed).
        if ($now - $lastLedgerTrim >= 3600) {
            godwit_trim_ledger($db, $now);
            $lastLedgerTrim = $now;
        }
    }
}

if ($rcd !== null) {
    proc_terminate($rcd['proc']);
    proc_close($rcd['proc']);
}
godwit_log($logFile, 'godwitd stopping (pid ' . getmypid() . ')');
