#!/bin/bash
# Godwit service control. Phase 1: supervises godwitd, which in turn
# supervises a single bundled rclone rcd.
set -u

PIDFILE="${GODWIT_PIDFILE:-/var/run/godwit.pid}"
LOGFILE="${GODWIT_LOG:-/var/log/godwit.log}"
DAEMON="$(dirname "$0")/godwitd"
RCLONE_BIN="$(cd "$(dirname "$0")/.." && pwd)/bin/rclone"
# 20 iterations x 0.5s = 10s in production; tests override this to stay fast.
STOP_WAIT_ITERATIONS="${GODWIT_STOP_WAIT_ITERATIONS:-20}"

is_running() {
    [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
    if is_running; then
        echo "godwit already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    rm -f "$PIDFILE"
    GODWIT_PIDFILE="$PIDFILE" GODWIT_LOG="$LOGFILE" "$DAEMON" </dev/null >>"$LOGFILE" 2>&1 &
    disown
    echo "godwit started"
}

stop() {
    if ! is_running; then
        rm -f "$PIDFILE"
        echo "godwit not running"
        return 0
    fi
    local pid
    pid="$(cat "$PIDFILE")"
    kill -TERM "$pid" 2>/dev/null
    for _ in $(seq 1 "$STOP_WAIT_ITERATIONS"); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.5
    done

    if kill -0 "$pid" 2>/dev/null; then
        echo "godwit did not stop gracefully within the wait — escalating to SIGKILL"
        kill -KILL "$pid" 2>/dev/null
        sleep 1
    fi

    # A SIGKILL bypasses godwitd's own shutdown handler (which normally
    # stops its rcd child), so make sure nothing from the bundled rclone
    # binary is left running regardless of how godwitd went down — this is
    # the process that will hold files open under /mnt/user in later
    # phases and must not survive rc.godwit stop under any path.
    pkill -KILL -f "$RCLONE_BIN rcd" 2>/dev/null || true

    rm -f "$PIDFILE"

    if kill -0 "$pid" 2>/dev/null; then
        echo "godwit stop FAILED — pid $pid still alive after SIGKILL"
        return 1
    fi
    if pgrep -f "$RCLONE_BIN rcd" >/dev/null 2>&1; then
        echo "godwit stop FAILED — a bundled rclone rcd process is still running"
        return 1
    fi
    echo "godwit stopped"
}

status() {
    if is_running; then
        echo "godwit running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    echo "godwit stopped"
    return 1
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) status ;;
    *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
